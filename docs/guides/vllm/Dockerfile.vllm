ARG VLLM_RUNTIME_IMAGE=vllm/vllm-openai:v0.28.0
FROM ${VLLM_RUNTIME_IMAGE}

ARG TARGETARCH=amd64

USER root

RUN set -eux; \
    if [ "${TARGETARCH}" != "amd64" ]; then \
      echo "Snapshot requires x86_64" >&2; \
      exit 1; \
    fi

WORKDIR /app
COPY app.py ./
ENTRYPOINT ["python3", "/app/app.py"]
